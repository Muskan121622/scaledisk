{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=scaledesk;Username=scaledesk;Password=scaledesk"
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "InvitationExpirationDays": 7,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 300,
    "AuthPermitPerMinute": 10,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "scaledesk",
    "Audience": "scaledesk-clients",
    "SecretKey": ""
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:29092",
    "TopicPrefix": "scaledesk.",
    "ConsumerGroup": "scaledesk-notifications",
    "BatchSize": 50,
    "PollIntervalMilliseconds": 1000
  },
  "Sla": {
    "Enabled": false,
    "IntervalSeconds": 30,
    "BatchSize": 200
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "scaledesk:"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Otel": {
    "Enabled": false,
    "Endpoint": ""
  },
  "Database": {
    "AutoMigrate": false
  }
}
